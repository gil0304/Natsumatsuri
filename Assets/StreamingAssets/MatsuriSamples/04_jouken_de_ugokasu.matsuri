// 祭りの最中の様子を見て、手を打つコード。
// 「もし」の中身は、条件が成り立った瞬間に実行される。

祭り "読みの祭り" {

    屋台 "たこ焼き" { 場所 -6, 0  値段 500 }
    屋台 "かき氷"   { 場所 6, 0   値段 300 }
    設備 "入り口"   { 場所 0, -20 }
    装飾 "鳥居"     { 場所 0, -16 }

    // 人が増えてきたら、屋台を足す。
    もし 来場者数 > 500 {
        屋台 "焼きそば" { 場所 -6, 8  値段 600 }
    }

    // たこ焼きの行列が伸びたら、2軒目を建てて分散させる。
    もし たこ焼き.待ち人数 > 20 {
        屋台 "たこ焼き" { 場所 6, 8  値段 500 }
    }

    // もうかったら、花火で還元する。
    もし 売上 > 500000 {
        花火 "スペシャル"
    }

    // 条件は「かつ」「または」でつなげる。
    もし 来場者数 > 300 かつ 満足度 > 60 {
        盆踊り
    }

    // 混んできたのに満足度が低いなら、ベンチを足して休ませる。
    もし 現在の来場者 > 200 かつ 満足度 < 50 {
        設備 "ベンチ" { 場所 12, -8 }
        設備 "ベンチ" { 場所 -12, -8 }
    }
}
