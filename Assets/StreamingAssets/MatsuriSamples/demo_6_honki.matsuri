// ═══════════════════════════════════════════════════════
//  DEMO 6  本気の祭り  ── 予算 1,000,000円 を使い切る
//
//  この構成の狙い:
//   ・回転の速い安い屋台をそろえて、行列を捌ききる
//     （りんご飴は1回3分、かき氷は5分。たこ焼きの8分より多く売れる）
//   ・盆踊り場と休憩所で「帰らせない」
//   ・行列が伸びたら、残った予算で自動的に屋台を足す
//   ・稼いだぶんを花火に変えて締める
//
//  合計 931,000円。残り 69,000円 は自動増築のために取ってある。
// ═══════════════════════════════════════════════════════

祭り "MATSURI.exe" {

    // ── 入口すぐ。歩き始めに買わせる（安くて速い）──
    屋台 "りんご飴"       { 場所 5, -13   値段 350 }
    屋台 "わたあめ"       { 場所 -5, -13  値段 350 }

    // ── 参道の中ほど。主力 ──
    屋台 "かき氷"         { 場所 7, -3    値段 450 }
    屋台 "たこ焼き"       { 場所 -7, -3   値段 600 }
    屋台 "フランクフルト" { 場所 7, 6     値段 450 }
    屋台 "型抜き"         { 場所 -7, 6    値段 250 }

    // ── 居場所。ここが効く ──
    設備 "盆踊り場" { 場所 0, -24 }
    設備 "休憩所"   { 場所 -16, -8 }
    設備 "休憩所"   { 場所 16, -8 }

    設備 "ベンチ" { 場所 -2, 0 }
    設備 "ベンチ" { 場所 2, 0 }
    設備 "ゴミ箱" { 場所 10, 0 }

    // ── 灯りと目印 ──
    装飾 "夏祭り看板" { 場所 0, -31 }
    装飾 "提灯" { 場所 0, -18 }
    装飾 "提灯" { 場所 0, -8 }
    装飾 "提灯" { 場所 0, 2 }
    装飾 "のぼり" { 場所 -3, -21 }
    装飾 "のぼり" { 場所 3, -21 }

    // ── 自動増築（残り予算 69,000円 で 型抜き 60,000円 が建つ）──
    もし たこ焼き.待ち人数 > 16 {
        屋台 "型抜き" { 場所 -14, 6  値段 250 }
    }

    // ── 見せ場 ──
    時間 19:00 { 太鼓 }
    時間 19:40 { 盆踊り }
    時間 20:30 { 花火 "大玉" }

    もし 売上 > 700000 {
        花火 "スペシャル"
    }
}
