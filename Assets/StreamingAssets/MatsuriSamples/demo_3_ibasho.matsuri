// ───────────────────────────────────────
//  DEMO 3  「居場所」を作って満足度を上げる
//
//  屋台は買ったら終わり。祭りに長く居てもらうには、
//  踊る場所・休む場所・お参りする場所が要る。
//  満足度が上がると、客はもう1軒まわってくれる。
//
//  ただし居場所は高い。
//  屋台を減らしてでも置く価値があるか？ ここが本作の勝負どころ。
//    盆踊り場 250,000 / 神社 200,000 / 休憩所 60,000 / 手水舎 40,000
// ───────────────────────────────────────

祭り "夏の居場所" {

    // 屋台は4軒だけ（合計 420,000円）
    屋台 "たこ焼き"   { 場所 8, 10   値段 550 }
    屋台 "かき氷"     { 場所 8, 2    値段 450 }
    屋台 "わたあめ"   { 場所 -8, 10  値段 350 }
    屋台 "金魚すくい" { 場所 -8, 2   値段 400 }

    // ── 踊る ──  やぐらを囲んで踊る。遊びたい客の満足度が大きく上がる
    設備 "盆踊り場" { 場所 0, -12 }

    // ── 休む ──  座って体力を回復する。疲れて早々に帰るのを防ぐ
    設備 "休憩所" { 場所 -15, -5 }

    // ── お参りする ──  参道の奥。満足度が大きく上がる
    設備 "神社"   { 場所 0, 26 }
    設備 "手水舎" { 場所 -6, 21 }

    装飾 "提灯"   { 場所 0, 0 }
    装飾 "のぼり" { 場所 -3, -20 }
    装飾 "のぼり" { 場所 3, -20 }
}
