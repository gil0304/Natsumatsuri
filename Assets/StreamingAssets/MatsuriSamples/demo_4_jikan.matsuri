// ───────────────────────────────────────
//  DEMO 4  時間でイベントを起こす
//
//  祭りは 17:00 に始まり 22:00 に終わる（実時間2分）。
//  「時間 20:30 { }」と書くと、その時刻に中身が実行される。
// ───────────────────────────────────────

祭り "花火の夜" {

    屋台 "たこ焼き"   { 場所 7, 8   値段 550 }
    屋台 "焼きそば"   { 場所 7, 0   値段 650 }
    屋台 "かき氷"     { 場所 -7, 8  値段 450 }
    屋台 "りんご飴"   { 場所 -7, 0  値段 350 }

    設備 "盆踊り場" { 場所 0, -12 }
    設備 "休憩所"   { 場所 -14, -4 }

    装飾 "提灯" { 場所 0, 4 }

    // 19:00 太鼓が鳴りはじめる
    時間 19:00 {
        太鼓
    }

    // 19:30 やぐらに人が集まって踊りだす
    時間 19:30 {
        盆踊り
    }

    // 20:30 大玉。ここが祭りのいちばん高いところ
    時間 20:30 {
        花火 "大玉"
    }

    // 21:30 締めのスペシャル
    時間 21:30 {
        花火 "スペシャル"
    }
}
