// ───────────────────────────────────────
//  DEMO 5  条件で祭りを自動運転する
//
//  「もし 〜 」は祭りの開催中ずっと見張られている。
//  条件が成立した瞬間に、中身が実行される。
//  つまり、客の入りを見て自分で増築する祭りが書ける。
// ───────────────────────────────────────

祭り "自動運転" {

    // 最初は小さく始める
    屋台 "たこ焼き" { 場所 6, 6  値段 500 }
    屋台 "かき氷"   { 場所 -6, 6 値段 400 }
    設備 "休憩所"   { 場所 0, -8 }

    // 人が集まってきたら、屋台を足す
    もし 来場者数 > 120 {
        屋台 "焼きそば" { 場所 6, -2  値段 650 }
    }

    もし 来場者数 > 300 {
        屋台 "わたあめ" { 場所 -6, -2  値段 350 }
        設備 "盆踊り場" { 場所 0, -18 }
    }

    // たこ焼きに行列ができすぎたら、2軒目を建てて捌く
    もし たこ焼き.待ち人数 > 14 {
        屋台 "たこ焼き" { 場所 13, 6  値段 550 }
    }

    // 稼げたら花火に投資する
    もし 売上 > 300000 {
        花火 "大玉"
    }

    もし 売上 > 600000 かつ 来場者数 > 400 {
        花火 "スペシャル"
    }
}
