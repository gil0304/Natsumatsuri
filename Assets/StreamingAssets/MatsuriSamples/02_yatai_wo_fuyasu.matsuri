// 屋台を増やして、祭りらしくしていく。

祭り "はじめての夏祭り" {

    // 値段は自分で決められる。安いほど売れるが、もうけは減る。
    屋台 "たこ焼き" {
        場所 -6, 4
        値段 500
    }

    屋台 "焼きそば" {
        場所 6, 4
        値段 600
    }

    屋台 "かき氷" {
        場所 -6, -4
        値段 300
    }

    // 遊びの屋台もあると、食べ物ばかりで飽きなくなる。
    屋台 "金魚すくい" {
        場所 6, -4
        値段 400
        向き 180
    }

    // 装飾は、夜の見た目と気分をよくする。
    装飾 "提灯" { 場所 -3, 0 }
    装飾 "提灯" { 場所 3, 0 }
    装飾 "のぼり" { 場所 0, 8 }

    // 設備は、お客さんの休憩や導線のため。
    設備 "ベンチ" { 場所 0, -8 }
    設備 "ゴミ箱" { 場所 9, -8 }

    // 決まった時刻にイベントを起こす。
    時間 19:00 {
        盆踊り
    }

    時間 20:30 {
        花火 "大玉"
    }
}
