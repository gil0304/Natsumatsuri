// @freemode
// ── 夏の宴 ────────────────────────────────────────
// 屋台11種を全部そろえた「全部入り」の見本。
//
// 合計およそ 1,690,000円。標準の予算 1,000,000円 では最後まで建たない。
// FREE MODE（予算無制限）で、会場いっぱいの祭りがどう見えるかを試すための構成。
// 標準の予算で遊ぶときは demo_6_honki.matsuri を見ること。

祭り "夏の宴" {

    // ── 入口と参道 ──────────────────────────────
    設備 "入り口" { 場所 0, -46 }
    設備 "出口"   { 場所 -10, -46 }
    装飾 "鳥居"   { 場所 0, -38 }
    設備 "案内板" { 場所 4, -34 }

    装飾 "提灯" { 場所 -4, -30 }
    装飾 "提灯" { 場所 4, -30 }
    装飾 "提灯" { 場所 -4, -18 }
    装飾 "提灯" { 場所 4, -18 }
    装飾 "提灯" { 場所 -4, -6 }
    装飾 "提灯" { 場所 4, -6 }
    装飾 "提灯" { 場所 -4, 6 }
    装飾 "提灯" { 場所 4, 6 }

    装飾 "のぼり" { 場所 -6, -26 }
    装飾 "のぼり" { 場所 6, -26 }
    装飾 "夏祭り看板" { 場所 0, -42 }

    // ── 食べ物の屋台（参道の左側） ───────────────
    屋台 "たこ焼き" {
        場所 -9, -24
        値段 500
        向き 90
    }
    屋台 "焼きそば" {
        場所 -9, -14
        値段 600
        向き 90
    }
    屋台 "かき氷" {
        場所 -9, -4
        値段 300
        向き 90
    }
    屋台 "りんご飴" {
        場所 -9, 6
        値段 400
        向き 90
    }
    屋台 "わたあめ" {
        場所 -9, 16
        値段 300
        向き 90
    }
    屋台 "フランクフルト" {
        場所 -9, 26
        値段 400
        向き 90
    }

    // ── 遊びの屋台（参道の右側） ─────────────────
    屋台 "金魚すくい" {
        場所 9, -24
        値段 400
        向き 270
    }
    屋台 "射的" {
        場所 9, -14
        値段 300
        向き 270
    }
    屋台 "ヨーヨー釣り" {
        場所 9, -4
        値段 300
        向き 270
    }
    屋台 "スーパーボールすくい" {
        場所 9, 6
        値段 300
        向き 270
    }
    屋台 "型抜き" {
        場所 9, 16
        値段 200
        向き 270
    }

    // ── 休むところ・きれいに保つもの ──────────────
    設備 "ベンチ" { 場所 -14, -20 }
    設備 "ベンチ" { 場所 -14, -10 }
    設備 "ベンチ" { 場所 14, -20 }
    設備 "ベンチ" { 場所 14, -10 }
    設備 "ゴミ箱" { 場所 -14, 0 }
    設備 "ゴミ箱" { 場所 14, 0 }
    設備 "トイレ" { 場所 20, 20 }

    // ── 奥のお社と木立 ──────────────────────────
    装飾 "神社" { 場所 0, 34 }
    装飾 "木" { 場所 -20, 28 }
    装飾 "木" { 場所 20, 28 }
    装飾 "木" { 場所 -24, 12 }
    装飾 "木" { 場所 24, 12 }
    装飾 "屋台用ライト" { 場所 0, 20 }

    // ── 時間で進む見せ場 (§15) ───────────────────
    時間 18:30 {
        太鼓
    }

    時間 19:00 {
        盆踊り
    }

    時間 20:00 {
        花火 "菊"
    }

    21:00 {
        花火 "大玉"
    }

    // ── 祭りの様子を見て手を打つ (§14 / §16 / §17) ──
    もし 来場者数 > 500 {
        屋台 "焼きそば" { 場所 -14, 16  値段 600 }
    }

    もし たこ焼き.待ち人数 > 20 {
        屋台 "たこ焼き" { 場所 14, 16  値段 500 }
    }

    もし 売上 > 500000 {
        花火 "スペシャル"
    }

    もし 来場者数 > 300 かつ 満足度 > 60 {
        装飾 "提灯" { 場所 0, 12 }
    }
}
