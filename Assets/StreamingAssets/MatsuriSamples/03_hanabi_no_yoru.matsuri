// 花火の夜。イベントで見せ場をつくる。

祭り "花火の夜" {

    屋台 "たこ焼き" { 場所 -8, 0  値段 500 }
    屋台 "わたあめ" { 場所 8, 0   値段 300 }

    装飾 "提灯" { 場所 -4, 6 }
    装飾 "提灯" { 場所 0, 6 }
    装飾 "提灯" { 場所 4, 6 }

    設備 "ベンチ" { 場所 -2, -10 }
    設備 "ベンチ" { 場所 2, -10 }

    // 太鼓で祭りの気分を上げてから、
    時間 18:30 {
        太鼓
    }

    // 盆踊りで人を集めて、
    時間 19:30 {
        盆踊り
    }

    // 最後に大玉を上げる。
    時間 21:00 {
        花火 "大玉"
    }

    21:30 {
        花火 "スペシャル"
    }
}
