// ───────────────────────────────────────
//  DEMO 2  参道に屋台を並べる
//  「場所 X, Z」は会場の座標。参道は Z=0 を南北に走っている。
//  値段を変えると、売れる数と売上が変わる。
// ───────────────────────────────────────

祭り "宵宮" {

    // ── 参道の東側（食べ物）──
    屋台 "たこ焼き"       { 場所 6, 14   値段 550 }
    屋台 "焼きそば"       { 場所 6, 7    値段 650 }
    屋台 "かき氷"         { 場所 6, 0    値段 450 }
    屋台 "りんご飴"       { 場所 6, -7   値段 350 }

    // ── 参道の西側（遊び）──
    屋台 "金魚すくい"     { 場所 -6, 14  値段 400 }
    屋台 "射的"           { 場所 -6, 7   値段 500 }
    屋台 "ヨーヨー釣り"   { 場所 -6, 0   値段 350 }

    // ── 灯り ──
    装飾 "提灯" { 場所 0, 10 }
    装飾 "提灯" { 場所 0, 3 }
    装飾 "提灯" { 場所 0, -4 }
}
